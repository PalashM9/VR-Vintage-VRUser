  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "| Description of activity / navigation moment in your app                 
    | Which Travel Task(s) does this correspond to? | Which navigation technique(s)
    to support it (and why)?                                                      
    |\r\n| ------------------------------------------------------------------------
    | --------------------------------------------- | ------------------------------------------------------------------------------------------------------------
    |\r\n| User spawns in the lobby and wants to reach the vintage car area        
    | Wayfinding + exploration                      | **Steering (continuous)** because
    users need flexible movement while learning the space                      |\r\n|
    User wants to walk around the car and inspect details (close-up viewing) | Exploration
    (local)                           | **Steering (slow speed)** + optional \u201Ccomfort
    mode\u201D later (FOV restriction)                                  |\r\n| User
    wants to move from car area to road start quickly                   | Wayfinding
    (goal-directed travel)             | **Instantaneous navigation later (teleport)**
    to reduce travel time + fatigue                                |\r\n| User enters
    the car and drives along the road route                      | Traversal / route
    following                   | **Vehicle locomotion** (your current CarMovementController)
    because it\u2019s diegetic and matches the experience |\r\n| User exits the car
    and returns to a viewing spot / photo spot            | Wayfinding + exploration                     
    | Steering for fine positioning; later teleport for \u201Cjump back to hub\u201D                                        
    |\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
